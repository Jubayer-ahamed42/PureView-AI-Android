{
  "appId": "com.pureview.ai",
  "appName": "PureView AI",
  "webDir": "public",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https",
    "cleartext": true,
    "allowNavigation": [
      "*.youtube.com",
      "*.googlevideo.com",
      "*.ytimg.com",
      "*.facebook.com",
      "*.fbcdn.net"
    ]
  },
  "android": {
    "allowMixedContent": true,
    "captureInput": true,
    "webContentsDebuggingEnabled": true,
    "backgroundColor": "#05110e"
  }
}
